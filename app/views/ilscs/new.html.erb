<% if params[:prog].include? "CPCU" %>
 <% nmprg = {"CPCUCST" => "CPCU Caregiver Skills Training","CPCUPR" => "CPCU Perkhidmatan Rawatan", "CPCUPPF" => "CPCU Pemberian Peralatan Fisioterapi"}
   prog = nmprg[params[:prog]]

  %>
<% else %>
 <% prog = params[:prog] %>
<% end %>
<div class="col-sm-8" style="background-color:#4c4cff; border-radius: 40px">
  <h5 style="color:white; font-weight: 600; text-align: center">PENDAFTARAN BARU UNTUK <%= prog %></h5>
</div>


<% if @cfm.present? %>
  <div style="font-size: 12px">
    <% if params[:prog] == "PERSEDIAAN ALAM PEKERJAAN" %>
      <%= render 'ilscs/form_sedia', actn: "new" %>
    <% elsif params[:prog] == "PENCARIAN PEKERJAAN" %>
      <%= render 'ilscs/form_cari', actn: "new" %>
    <% elsif params[:prog] == "DET & JOB COACH" %>
      <%= render 'ilscs/form_det', actn: "new" %>
    <% elsif params[:prog] == "CPCUPR" %>
      <%= render 'ilscs/form_cpcupr', actn: "new" %>
    <% elsif params[:prog] == "CPCUPPF" %>
      <%= render 'ilscs/form_cpcuppf', actn: "new" %>
    <% elsif params[:prog] == "CPCUCST" %>
      <%= render 'ilscs/form_cpcucst', actn: "new" %>
    <% elsif @ilsc.tp == "CPCU" %>
      <%= render 'ilscs/form_cpcu', actn: "new" %>
    <% end %>
  </div>
<% else %>

    <%= form_tag new_ilsc_path, method: :get, id: "find_kid" do %>
      <div class="row">
        <div class="col-lg-5 col-md-7 col-sm-10">
          
          <%= text_field_tag :ic, params[:ic], class: "form-control form-control-sm", placeholder: "Sila Masukkan No MYKAD/MYKID Peserta", required: true, minlenght: 2 %>
          <%= hidden_field_tag :sch, params[:sch], value: "sdhjdsh876671" %>
          <%= hidden_field_tag :prog, params[:prog], value: params[:prog] %>
          <%= hidden_field_tag :perse, params[:perse], value: params[:perse] %>
          <%= hidden_field_tag :nwiframe, params[:nwiframe], value: params[:nwiframe] %>
        </div>
        <div class="col-lg-2 col-md-2 col-sm-2">
          <%= button_tag(type: :submit, class: "btn btn-sm btn-success", style: "") do %>
            <i class=""></i> Teruskan
          <% end %>
        </div>
      </div>

    <% end %>

  

<% end %>