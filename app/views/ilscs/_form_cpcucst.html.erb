            <%= f.date_field :dobn, class: "form-control", placeholder: "", autofocus: true, required: true, style: "text-transform: uppercase" %>
          </div>
        </div>
      </div>

    <h6><b><u>MAKLUMAT PERUBATAN ANAK</u></b></h6>

    <div class="table-responsive border" style="font-size: 12px">
      <table class="table table-bordered table-striped shadow" id="dataTable" width="100%" cellspacing="0">
        <thead style="text-align: center">
          <tr class="shadow">
            <th style="background-color:#7fbf7f;color:black">NAMA KLINIK/HOSPITAL</th>
            <th style="background-color:#7fbf7f;color:black">DIAGNOSIS</th>
          </tr>
        </thead>
        <tbody style="color: black">
          <%= f.fields_for :hosdoc do |h| %>
          <% (1..5).each do |n| %>
          <%= h.fields_for :"#{n}" do |g| %>
            <tr>
              <td>
                <%= g.text_field :hosnm, class: "form-control", placeholder: "", autofocus: true, style: "font-size: 12px", value: @ilsc.hosdoc["#{n}"][0] %>
              </td>
              <td>
                <%= g.text_field :diag, class: "form-control", placeholder: "", autofocus: true, style: "font-size: 12px", value: @ilsc.hosdoc["#{n}"][1] %>
              </td>
            </tr>
          <% end %>
          <% end %>
          <% end %>
                 
        </tbody>

      </table>
    </div> <!-- DIV TABLE -->
    <br>
    
    <div class="form-group"> 
      <div class="row">
        <div class="control-label col-sm-8">
