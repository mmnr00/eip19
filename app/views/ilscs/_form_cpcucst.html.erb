        <div class="col-sm-8 col-12">
           <% 
            if @ilsc.ic.present?
              icval = @ilsc.ic
            else
              icval = params[:ic]
            end 
          %>
          <%= f.number_field :ic, class: "form-control", placeholder: "cth: 141201035647 (tiada dash)", autofocus: true, required: true, value: icval, readonly: true %>
        </div>
      </div>
    </div>

    <div class="form-group"> 
