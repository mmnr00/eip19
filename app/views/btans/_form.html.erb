       <!--  Maklumat Tanggungan Ketua Isi Rumah -->

      <div class="col-sm-8" style="background-color:#ffcccc">
        <h6 style="color:black; font-weight: 600">Maklumat Tanggungan Ketua Isi Rumah</h6>
      </div>

      <div class="table-responsive border" style="font-size: 12px">
        <table class="table table-bordered table-striped shadow" id="dataTable" width="100%" cellspacing="0">
          <thead style="text-align: center">
            <tr class="shadow">
              <th style="background-color:#7fbf7f;color:black">NAMA PENUH</th>
              <th style="background-color:#7fbf7f;color:black">NO KP/<br>SIJIL KELAHIRAN</th>
              <th style="background-color:#7fbf7f;color:black">HUBUNGAN</th>
              <th style="background-color:#7fbf7f;color:black">UMUR</th>
              <th style="background-color:#7fbf7f;color:black">PENDAPATAN BULANAN <br>(RM)</th>
            </tr>
          </thead>
          <tbody style="color: black">
            <%= f.fields_for :household do |h| %>
            <% (1..10).each do |n| %>
            <%= h.fields_for :"#{n}" do |g| %>
              <tr>
                <td>
                  <%= g.text_field :"nama", class: "form-control", placeholder: "", autofocus: true, style: "font-size: 12px", value: @btan.household["#{n}"][0] %>
                </td>
                <td>
                  <%= g.text_field :"kp", class: "form-control", placeholder: "", autofocus: true, style: "font-size: 12px", value: @btan.household["#{n}"][1] %>
                </td>
                <td>
                  <%= g.text_field :"hubg", class: "form-control", placeholder: "", autofocus: true, style: "font-size: 12px", value: @btan.household["#{n}"][2] %>
                </td>
                <td>
                  <%= g.text_field :"umur", class: "form-control", placeholder: "", autofocus: true, style: "font-size: 12px", value: @btan.household["#{n}"][3] %>
                </td>
                <td>
                  <%= g.text_field :"pend", class: "form-control", placeholder: "", autofocus: true, style: "font-size: 12px", value: @btan.household["#{n}"][4] %>
                </td>
              </tr>
            <% end %>
            <% end %>
            <% end %>
                   
          </tbody>

        </table>

      </div> <!-- DIV TABLE --><br>

      <div class="form-group"> 
          <div class="row">
            <div class="control-label col-sm-8">
              <i class="fas fa-cloud-upload-alt"></i><strong>SURAT DIAGNOSIS</strong>
            </div>
          </div>
          <div class="row">
            <div class="col-sm-8 col-12">
              <% image = @btan.fotos.where(foto_name: "DIAGNOSIS").first %>
              <%  if image.present? %>
                <%= image_tag(image.picture.url, size: "200x200") if image.picture? %>
                <div class="row">
                  <div class="col-sm-8 col-5">
                    <strong><%= link_to "EDIT", edit_foto_path(image.id), class: "btn btn-sm btn-success active" %></strong>
                  </div>
                </div>  
              <% else %>
                <%= f.fields_for :fotos do |h| %>
                  <div class="row">
                    <div class="col-sm-8 col-8">
                      <%= h.hidden_field :foto_name, value: "DIAGNOSIS" %>
                      <%= h.file_field :picture, accept: 'image/jpeg,image/gif,image/png,application/pdf', required: true %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
          <i>Wajib Disertakan</i>
        </div>

        <div class="form-group"> 
          <div class="row">
            <div class="control-label col-sm-8">
              <i class="fas fa-cloud-upload-alt"></i><strong>SURAT DIAGNOSIS 2</strong>
            </div>
          </div>
          <div class="row">
            <div class="col-sm-8 col-12">
              <% image = @btan.fotos.where(foto_name: "DIAGNOSIS2").first %>
              <%  if image.present? %>
                <%= image_tag(image.picture.url, size: "200x200") if image.picture? %>
                <div class="row">
                  <div class="col-sm-8 col-5">
                    <strong><%= link_to "EDIT", edit_foto_path(image.id), class: "btn btn-sm btn-success active" %></strong>
                  </div>
                </div>  
              <% else %>
                <%= f.fields_for :fotos do |h| %>
                  <div class="row">
                    <div class="col-sm-8 col-8">
                      <%= h.hidden_field :foto_name, value: "DIAGNOSIS2" %>
                      <%= h.file_field :picture, accept: 'image/jpeg,image/gif,image/png,application/pdf' %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
          <i>Wajib Disertakan</i>
        </div>

      <div class="col-sm-8" style="background-color:#ffcccc">
        <h6 style="color:black; font-weight: 600">Sumbangan Bantuan Yang Telah Diterima (Jumlah Tahunan)</h6>
      </div>
      <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_area :sekkd, class: "form-control", autofocus: true, style: "text-transform: uppercase" %>
          </div>
        </div>

      

      
      <%= f.hidden_field :perse_id, value: params[:perse] %>

      <div style="margin-top: 5px; margin-bottom: 5px;">
        <%= f.check_box :tnc, value: 1, required: true %>  Saya mengesahkan segala maklumat adalah benar sekiranya tidak permohonan ini akan terbatal dengan serta merta
      </div>


      <br>
<!-- SUBMIT BUTTON -->
      <div class="form-group">
        <div class="row">
          <div class="col-sm-offset-2 col-sm-10 col-4">
            <%= f.submit :"TERUSKAN",  class: 'btn btn-primary btn-lg' %>
          </div>
        </div>
      </div>
      
    <% end %>

  </div>
</div>

