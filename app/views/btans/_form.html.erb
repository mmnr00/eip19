<div class='row'>
  <div class='col-lg-12 col-12'>
    <%= form_for(@btan,:html => {multipart: true, class: "form-horizontal", role: "form"}) do |f| %>

    <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>TUJUAN PERMOHONAN</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.select :purp, options_for_select(["Tujuan 1", 
                                                  "Tujuan 2"], 
                                                  selected: @btan.purp), 
            {include_blank: "SILA PILIH"}, {required: true} %>
          </div>
        </div>
      </div>

      <div class="col-sm-8" style="background-color:#ffcccc">
        <h6 style="color:black; font-weight: 600">Maklumat Pendaftaran</h6>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>JUMLAH BANTUAN (RM)</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.number_field :amnt, class: "form-control", autofocus: true, required: true, style: "text-transform: uppercase" %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>DUN</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
             <%= f.select :dun, options_for_select($dun_list, 
                                                  selected: @btan.dun), 
            {include_blank: "SILA PILIH"}, {required: true} %>
        </div>
      </div><br>

     <!--  Maklumat Penjaga (Pemohon) -->

      <div class="col-sm-8" style="background-color:#ffcccc">
        <h6 style="color:black; font-weight: 600">Maklumat Penjaga (Pemohon)</h6>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>NAMA </strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <% 
              if @btan.name.present?
                nameval = @btan.name
              else
                nameval = @perse.name 
              end
            %>
            <%= f.text_field :name, class: "form-control", placeholder: "Nama Penuh Seperti MyKad", autofocus: true, required: true, style: "text-transform: uppercase", value: nameval %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>NO K/P </strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <% 
              if @btan.ic.present?
                icval = @btan.ic
              else
                icval = @perse.ic 
              end
            %>
            <%= f.number_field :ic, class: "form-control", autofocus: true, required: true, style: "text-transform: uppercase", value: icval, readonly: true %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>STATUS PERKAHWINAN</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.select :marr, options_for_select(["Bujang","Berkahwin","Bercerai","Lain-Lain"], 
                                                  selected: @btan.marr), 
            {include_blank: "SILA PILIH"}, {required: true} %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>ALAMAT KEDIAMAN</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.text_area :addr, class: "form-control", autofocus: true, required: true, style: "text-transform: uppercase" %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>TEMPOH MENETAP DI SELANGOR</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
            <%= f.number_field :perd, class: "form-control", autofocus: true, required: true, style: "text-transform: uppercase" %>
          </div>
        </div>
      </div>

      <div class="form-group"> 
        <div class="row">
          <div class="control-label col-sm-8">
            <strong>PENGUNDI DI SELANGOR</strong>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-8 col-12">
