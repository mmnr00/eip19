<meta name="viewport" content="width=1024">

<%
  btn_hash = {
    nil=>["primary","secondary","secondary","secondary"],
    "memo"=>["secondary","primary","secondary","secondary"],
    "pmt"=>["secondary","secondary","primary","secondary"],
    "panel"=>["secondary","secondary","secondary","primary"]
  }
%>

<ol class="breadcrumb">
  <li class="breadcrumb-item">
    Permohonan untuk Program <b>Bantuan ANIS</b>
  </li>
  &nbsp &nbsp <%= link_to lsbtan_path, class: "badge badge-#{btn_hash[params[:dsb]][0]} shadow-sm", style: "font-size: 14px; font-weight: normal" do %>
        <i class="fa fa-sync"></i> Paparan Utama
    <% end %>
    &nbsp &nbsp <%= link_to lsbtan_path(dsb: "memo"), class: "badge badge-#{btn_hash[params[:dsb]][1]} shadow-sm", style: "font-size: 14px; font-weight: normal" do %>
        <i class="fa fa-sync"></i> Memo
    <% end %>
    &nbsp &nbsp <%= link_to lsbtan_path(dsb: "pmt"), class: "badge badge-#{btn_hash[params[:dsb]][2]} shadow-sm", style: "font-size: 14px; font-weight: normal" do %>
        <i class="fa fa-sync"></i> Maklumat Bayaran
    <% end %>
    &nbsp &nbsp <%= link_to lsbtan_path(dsb: "panel"), class: "badge badge-#{btn_hash[params[:dsb]][3]} shadow-sm", style: "font-size: 14px; font-weight: normal" do %>
        <i class="fa fa-sync"></i> Senarai Panel
    <% end %>
</ol>



<% if params[:dsb] == "memo" %>
  <%= render 'btans/memodsb' %>
<% elsif params[:dsb] == "pmt" %>
  <%= render 'btans/pmtdsb' %>
<% elsif params[:dsb] == "panel" %>
  <%= render 'btans/paneldsb' %>
<% else %>
  <%= render 'btans/maindsb' %>
<% end %>








