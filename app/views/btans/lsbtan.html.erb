<!-- TABLE -->
<br>
<div class="cards shadow mb-4">
  <div class="card-header">
    <div class="row">
      <%= form_tag lsddk_path, method: :get, id: "find_kid" do %>
        <%= text_field_tag :sch_str, params[:sch_str], placeholder: "Masukkan Carian", style: 'text-transform: uppercase', required: true %>
        <%= select_tag :sch_fld, options_for_select(["No Siri (4 no belakang)", "Nama Agensi","No Pendaftaran Agensi"], params[:sch_fld]),
              include_blank: "Pilih Carian", required: true %>
        <%= hidden_field_tag :stat, params[:stat], value: params[:stat] %>
        <%= hidden_field_tag :sch, params[:sch], value: true %>
        <%= button_tag(type: :submit, class: "badge badge-success shadow-none", style: "font-size: 14px; border-style: none; font-weight: normal",  id: "submit_expense") do %>
            <i class="fa fa-search"></i> Cari
        <% end %>
        <%= link_to lsddk_path, class: "badge badge-danger shadow-sm", style: "font-size: 14px; font-weight: normal" do %>
            <i class="fa fa-sync"></i> Semula
        <% end %>
        <%= "#{@ddk.count} carian" unless params[:sch].blank? %>
        <%= link_to oldlsddk_path, class: "badge badge-secondary shadow-sm", target: "_blank", style: "font-size: 18px; font-weight: normal" do %>
            <i class="fa fa-sync"></i> Rekod Terdahulu
        <% end %>
      <% end %>

      <div>
        
      </div>
    </div>
  </div>
  <div class="card-body">
    
    <div class="table table-responsive border" style="font-size:13px">
      <table class="table table-bordered table-striped shadow" id="dataTable" width="100%" cellspacing="0" style="color: black">
        <thead>
          <tr class="shadow">
            <th style="background-color:#ffb2b2; width: ">NO</th>
            <th style="background-color:#ffb2b2">MAKLUMAT PEMOHON</th>
            <th style="background-color:#ffb2b2">MAKLUMAT ANAK ISTIMEWA</th>
            <th style="background-color:#ffb2b2; width: ">DUN</th>
            <th style="background-color:#ffb2b2">JUMLAH BANTUAN</th>
            <th style="background-color:#ffb2b2">TARIKH MOHON</th>
            <th style="background-color:#ffb2b2">TUJUAN PERMOHONAN</th>
            <th style="background-color:#ffb2b2">STATUS</th>
          </tr>
        </thead>
        <tbody>
          <% cnt = 1; @btans.each do |bt| %>
          <tr>
            <td><%= cnt %></td>
            <td><a href="<%= btan_url(id: bt.id) %>" target="_blank"><%= bt.name %></a><br>
                <%= bt.ic %>
            </td>
            <td>
              <%= bt.nmkd %><br>
              <%= bt.ickd %>
            </td>
            <td><%= bt.dun %></td>
            <td><%= bt.amnt %></td>
            <td><%= bt.created_at.strftime('%d-%^b-%Y') %></td>
            <td><%= bt.purp %></td>
            <td><%= bt.stat %></td>
          </tr>
          <% cnt = cnt+1 ;end %>
        </tbody>
      </table>
    </div>
  </div>
</div>








