<!-- TABLE -->
<br>
<div class="cards shadow mb-12">
  <div class="card-header">
    <div class="row">
      <%= form_tag lsbtan_path, method: :get, id: "find_kid" do %>
        <%= text_field_tag :sch_str, params[:sch_str], placeholder: "Nama / MYKAD", style: 'text-transform: uppercase' %>
        <%= select_tag :sch_tp, options_for_select(["Saringan Awal","Makanan / Keperluan Tambahan", 
                                                  "Pendidikan (Terapi/Kelas Khas)", "Pembelian/Pembaikan Peralatan/Mesin", "Ubat-ubatan", "Lain-lain"], params[:sch_tp]),
              include_blank: "Tujuan Permohonan" %>
        <%= hidden_field_tag :stat, params[:stat], value: params[:stat] %>
        <%= hidden_field_tag :sch, params[:sch], value: true %>
        <%= button_tag(type: :submit, class: "badge badge-success shadow-none", style: "font-size: 14px; border-style: none; font-weight: normal",  id: "submit_expense") do %>
            <i class="fa fa-search"></i> Cari
        <% end %>
        <%= link_to lsbtan_path, class: "badge badge-danger shadow-sm", style: "font-size: 14px; font-weight: normal" do %>
            <i class="fa fa-sync"></i> Semula
        <% end %>
        <%= "#{@btans.count} carian" unless params[:sch].blank? %>
        <% link_to oldlsddk_path, class: "badge badge-secondary shadow-sm", target: "_blank", style: "font-size: 18px; font-weight: normal" do %>
            <i class="fa fa-sync"></i> Rekod Terdahulu
        <% end %>
      <% end %>

      <div>
        
      </div>
    </div>
  </div>
  <div class="card-body">
    
    <div class="table table-responsive border" style="font-size:13px">
      <table class="table table-bordered table-striped shadow" id="dataTable" width="100%" cellspacing="0" style="color: black">
        <thead>
          <tr class="shadow">
            <th style="background-color:#ffb2b2; width: ">NO</th>
            <th style="background-color:#ffb2b2">MAKLUMAT ANAK ISTIMEWA</th>
            <th style="background-color:#ffb2b2">MAKLUMAT PEMOHON</th>
            <th style="background-color:#ffb2b2; width: ">DUN</th>
            <th style="background-color:#ffb2b2">JUMLAH BANTUAN</th>
            <th style="background-color:#ffb2b2">TARIKH MOHON</th>
            <th style="background-color:#ffb2b2">TUJUAN PERMOHONAN</th>
            <th style="background-color:#ffb2b2">STATUS</th>
          </tr>
        </thead>
        <tbody>
          <% cnt = 1; @btans.order('created_at DESC').each do |bt| %>
          <tr>
            <td><%= cnt %></td>
            <td>
              <a href="<%= btan_url(id: bt.id) %>" target="_blank"><%= bt.nmkd %></a><br>
              <%= bt.ickd %><br>
              <%= link_to "Kemaskini Profil", edit_btan_path(id: bt.id, perse: bt.perse.id), class: "badge badge-pill badge-warning", target: "_blank" %><br>
              <% link_to "Padam", root_path(id: bt.id, del: 1), class: "badge badge-pill badge-danger" %><br>
            </td>
            <td><%= bt.name %><br>
                <%= bt.ic %><br>
                <%= bt.phmb %>
            </td>
            
            <td><%= bt.dun %></td>
            <td><%= bt.amnt %></td>
            <td><%= bt.created_at.strftime('%d-%^b-%Y') %></td>
            <td><%= bt.purp %></td>
            <td><%= bt.stat %></td>
          </tr>
          <% cnt = cnt+1 ;end %>
        </tbody>
      </table>
    </div>
  </div>
</div>